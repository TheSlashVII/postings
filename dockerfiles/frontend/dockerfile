FROM node:latest AS build
WORKDIR /home/node/frontend
COPY postings_frontend .
RUN npm i
RUN npm run build

FROM nginx:latest
COPY --from=build --chmod=755 /home/node/frontend/dist /usr/share/nginx/html/
RUN mv /etc/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf.old
COPY --chmod=644 default.conf /etc/nginx/conf.d/
EXPOSE 80

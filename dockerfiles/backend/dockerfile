# build stage
FROM node:latest AS build
WORKDIR /home/node/backend
COPY --chmod=755 postings_backend/  .
# install the environment
RUN npm i
# compile the code
RUN npm run build
# uncomment if you need to run migrations on the database (usually needed for the first time you run this app)
# RUN npm run migration:run -- -d dist/db/postings.datasource.js

# run stage
FROM build AS start
# switch working dir to the current 
WORKDIR /home/node/backend/dist
# ENV NODE_ENV="production node dist/main.js"
EXPOSE 3000
# run the code
CMD [ "node", "main.js" ]
